#!/bin/bash

RED="\033[1;91m"
GREEN="\033[1;92m"

NORMAL="\033[0m"
BOLD="\033[1m"
BLINK="\033[5m"

if [[ "$1" == "up" ]]; then
    if [[ -f "/usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini.disabled" ]]; then
        mv /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini.disabled /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini
        kill -USR2 1
        echo -e "xdebug is now ${BLINK}${BOLD}${GREEN}>>> enabled <<<${NORMAL}"
    else
        echo -e "xdebug is already ${BLINK}${BOLD}${GREEN}>>> enabled <<<${NORMAL}"
    fi
else
    if [[ "$1" == "down" ]]; then
        if [[ -f "/usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini" ]]; then
            mv /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini  /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini.disabled
            kill -USR2 1
            echo -e "xdebug is now ${BLINK}${BOLD}${RED}>>> disabled <<<${NORMAL}"
        else
            echo -e "xdebug is already ${BLINK}${BOLD}${RED}>>> disabled <<<${NORMAL}"
        fi
    else
        if [[ -f "/usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini.disabled" ]]; then
            echo -e "xdebug is currently ${BLINK}${BOLD}${RED}>>> disabled <<<${NORMAL}"
        else
            echo -e "xdebug is currently ${BLINK}${BOLD}${GREEN}>>> enabled <<<${NORMAL}"
        fi
    fi
fi
