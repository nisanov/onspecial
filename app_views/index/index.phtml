                    </button>
                    <img data-image="<?php echo $product->image; ?>" data-src="<?php echo $product->thumb; ?>" src="<?php echo $this->url->getStatic('img/placeholder.jpg'); ?>" onerror="this.src='<?php echo $this->url->getStatic('img/placeholder.jpg'); ?>'" alt="<?php echo $product->name; ?>" />
